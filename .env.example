# ─── Wallets ──────────────────────────────────────────────────────────────────
# Deployer wallet — pays gas for contract deployments and delegation txs
PRIVATE_KEY=0xyour_deployer_private_key

# Secondary wallet (optional — used for testing with a second account)
PRIVATE_KEY2=0xyour_second_private_key

# Platform owner / whitelisted user — signs UserOps (needs no ETH for gasless ops)
OWNER_PRIVATE_KEY=0xyour_owner_private_key

# ─── RPC Endpoints ────────────────────────────────────────────────────────────
# Get free endpoints at https://infura.io or https://alchemy.com
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_infura_project_id
AMOY_RPC_URL=https://polygon-amoy.infura.io/v3/your_infura_project_id
XRPL_EVM_TESTNET_RPC_URL=https://rpc.testnet.xrplevm.org
XRPL_EVM_MAINNET_RPC_URL=https://rpc.xrplevm.org

# ─── Bundler ──────────────────────────────────────────────────────────────────
# Get a free Pimlico API key at https://dashboard.pimlico.io
# One Pimlico key per network (preferred), or a shared fallback.
PIMLICO_API_KEY_SEPOLIA=pim_your_sepolia_key
PIMLICO_API_KEY_AMOY=pim_your_amoy_key
PIMLICO_API_KEY=pim_shared_fallback_key

# ─── EntryPoint ───────────────────────────────────────────────────────────────
# Canonical EntryPoint v0.8 — same address on all supported chains
ENTRY_POINT=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108

# ─── Document / Token Config ──────────────────────────────────────────────────
# Used by mintDocumentGasless.ts
TOKEN_ID=0x1
TOKEN_NAME=MyRegistry
TOKEN_SYMBOL=MYR
REMARK=optional remark text
BENEFICIARY_ADDRESS=0xC04Af4f9817605340d39104E91fc1709F315E549
HOLDER_ADDRESS=0xC04Af4f9817605340d39104E91fc1709F315E549
NOMINEE_ADDR=0xC04Af4f9817605340d39104E91fc1709F315E549
NEW_HOLDER_ADDR=0xC04Af4f9817605340d39104E91fc1709F315E549

# ─── Sepolia Deployments ──────────────────────────────────────────────────────
# Like Amoy, but EOAs delegate to Simple7702Account (see below). Reuses TrustVC's
# TDocDeployer and TokenImplementation. Run with --network sepolia: deployImplementation.ts →
# deployFactory.ts → deployPlatformPaymaster.ts → stakePlatformPaymaster.ts →
# setUserWhitelist.ts. Skip deployEIP7702.ts and deployPermissionlessSimple7702.ts.
# Gasless scripts use Pimlico (PIMLICO_API_KEY_SEPOLIA, else PIMLICO_API_KEY); override with BUNDLER_URL_SEPOLIA.
# The old ignition deployment 0x5dcDf7fA…F4Ff is not a clone factory — don't use it.

# TrustVC's Sepolia EIP7702Implementation — NOT used: bound to EntryPoint v0.7.
# Sepolia EOAs delegate to Simple7702Account 0xe6Cae83B…555B (EntryPoint v0.8),
# chosen in scripts/lib/network.ts getAccountImpl().
EIP7702_IMPL_ADDRESS_SEPOLIA=0xa46EC3920Ac5fc54F4bA33185A91ae250aDF59B8
# Ours, not TrustVC's: their paymaster implementation 0xA2469517…752b (factory
# 0x7E9ef636…dc9f) is the same older build as on Amoy (deployer gets only DEFAULT_ADMIN).
PAYMASTER_IMPLEMENTATION_SEPOLIA=0x907baba3ec581319168a4ec12ed8632ea437c28b
FACTORY_ADDRESS_SEPOLIA=0xe55a72a9922f3f9ffb84859bee0191254dd94fa2
PAYMASTER_ADDRESS_SEPOLIA=0x41F22fA1B065192c6b88B8c744E44ea4b2dA70FD

# TrustVC infrastructure on Sepolia (pre-deployed — do not change)
TDOC_DEPLOYER_ADDRESS_SEPOLIA=0x64bc665056DC8bE4092e569ED13a7F273Be28cD2
TDOC_IMPLEMENTATION_SEPOLIA=0x45c382574bb1B9C432a2e100Ab2086A4EAcB73Fd

# Filled in after running deployRegistryGasless.ts / mintDocumentGasless.ts
REGISTRY_ADDRESS_SEPOLIA=0x_filled_after_deployRegistry
TITLE_ESCROW_ADDRESS_SEPOLIA=0x_filled_after_mintDocument

# ─── Polygon Amoy Deployments ─────────────────────────────────────────────────
# Reuses TrustVC's EIP7702Implementation, TDocDeployer and TokenImplementation.
# Run with --network amoy: deployImplementation.ts → deployFactory.ts →
# deployPlatformPaymaster.ts → stakePlatformPaymaster.ts → setUserWhitelist.ts.
# Skip deployEIP7702.ts and deployPermissionlessSimple7702.ts.
# Gasless scripts use Pimlico (PIMLICO_API_KEY_AMOY, else PIMLICO_API_KEY); override with BUNDLER_URL_AMOY.

# TrustVC shared EIP7702Implementation (same source as contracts/EIP7702Implementation.sol) — do not redeploy
EIP7702_IMPL_ADDRESS_AMOY=0x044DE1d4515a76Ed9E431e8EC89e8D600405Fd86
# Ours, not TrustVC's: their paymaster implementation 0x1c436712…Fea7 (factory
# 0xFBE1d336…8409) is an older build that leaves the registry deployer without
# MINTER/RESTORER/ACCEPTER (checkRegistryRoles.ts ✗). Its clone
# 0xd1DB81155851511a073dC6f5fe6E3eA637Dde21C was retired on 2026-10-01 (stake unlocked).
PAYMASTER_IMPLEMENTATION_AMOY=0xf75102a7c1ab7d9881551a4493e891ccdc2ebb52
FACTORY_ADDRESS_AMOY=0xc14f88e5619277d654deb6ebc73514f98cc01efe
PAYMASTER_ADDRESS_AMOY=0x3Fbf0cDCC7AddF97A0084D63eDe25d159E1e5908

# TrustVC infrastructure on Amoy (pre-deployed — do not change)
TDOC_DEPLOYER_ADDRESS_AMOY=0xfcafea839e576967b96ad1FBFB52b5CA26cd1D25
TDOC_IMPLEMENTATION_AMOY=0x45c382574bb1B9C432a2e100Ab2086A4EAcB73Fd

# Filled in after running gasless scripts with NETWORK=amoy
REGISTRY_ADDRESS_AMOY=0x_filled_after_deployRegistry
TITLE_ESCROW_ADDRESS_AMOY=0x_filled_after_mintDocument

# ─── Polygon PoS Mainnet (137) ────────────────────────────────────────────────
# EntryPoint v0.8, Simple7702Account (delegation target) and TrustVC TDoc contracts
# are already on Polygon — skip deployPermissionlessSimple7702.ts / deployEIP7702.ts.
# Run with --network polygon: deployImplementation.ts → deployFactory.ts →
# deployPlatformPaymaster.ts → stakePlatformPaymaster.ts → setUserWhitelist.ts.
# Bundler: Pimlico (PIMLICO_API_KEY_POLYGON, else PIMLICO_API_KEY); override with BUNDLER_URL_POLYGON.
# Use a dedicated mainnet PRIVATE_KEY funded with POL.
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/your_infura_project_id
PIMLICO_API_KEY_POLYGON=pim_your_polygon_key
PAYMASTER_IMPLEMENTATION_POLYGON=0xdfd6c60817c7d27a8bb2f38f44ea007e6b7ee4a6
FACTORY_ADDRESS_POLYGON=0x41b86767cb90e87d2b7c3779ebd86220798a0c82
PAYMASTER_ADDRESS_POLYGON=0x67728c5a0E121fE6C56a1cC09e077c6fCAf9199D
# TrustVC infrastructure on Polygon (pre-deployed — do not change)
TDOC_DEPLOYER_ADDRESS_POLYGON=0xddDabC072c7Ea9c40e3751ff834519be15BCFA54
TDOC_IMPLEMENTATION_POLYGON=0x315d005Ea83E2B296CeD559F8228266dDa885091
REGISTRY_ADDRESS_POLYGON=0x739d3b8AB5f0e50B822B403884767ecdAe35B759

# ─── XRPL EVM Testnet Deployments ────────────────────────────────────────────
# Same deploy order as above but with --network xrplEvmTestnet and NETWORK=xrplEvmTestnet
#
# CRITICAL for gasless (bp-react / permissionless):
#   npx hardhat run scripts/deployPermissionlessSimple7702.ts --network xrplEvmTestnet
# That CREATE2-deploys Simple7702Account at 0xe6Cae83… (required by to7702SimpleSmartAccount).
# EIP7702_IMPL below is the OpenZeppelin account — NOT used by the SPA gasless path.

EIP7702_IMPL_ADDRESS_XRPL_EVM_TESTNET=0xa1d443ebde9835aae1f25a36e469ccc6456915dc
PERMISSIONLESS_7702_IMPL_ADDRESS=0xe6Cae83BdE06E4c305530e199D7217f42808555B
PAYMASTER_IMPLEMENTATION_XRPL_EVM_TESTNET=0x378da734da6a3b4d62988f1c2b25059a435c1fc5
FACTORY_ADDRESS_XRPL_EVM_TESTNET=0xddcff6749acbb8faa9ec5fb57264bf589226c8a1
PAYMASTER_ADDRESS_XRPL_EVM_TESTNET=0x7B0057a6671776626f5410F31523a67b36639E35

# TrustVC infrastructure on XRPL EVM Testnet (pre-deployed — do not change)
TDOC_DEPLOYER_ADDRESS_XRPL_EVM_TESTNET=0xDf2A8d7A03C997a62fC23B296d03b9467FB51D89
TDOC_IMPLEMENTATION_XRPL_EVM_TESTNET=0xe876Ba83ccb2326d70E0b5739179195A38982030

REGISTRY_ADDRESS_XRPL_EVM_TESTNET=0xb016fCe0d1bF12cAF8908972A3A62c96E6A1e449
TITLE_ESCROW_ADDRESS_XRPL_EVM_TESTNET=0xF5315BCc3009CC1EC57a8655080667928a80d9CB

# ─── XRPL EVM Mainnet ─────────────────────────────────────────────────────────
# Alto requires canonical EntryPoint v0.8 before it will start:
#   0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108
# Deploy once (CREATE2, ~0.01 XRP gas) from a funded PRIVATE_KEY:
#   npx hardhat run scripts/deployEntryPoint08.ts --network xrplEvmMainnet
#
# ENTRY_POINT_XRPL_EVM_MAINNET=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108
#
# Gasless on mainnet — same contracts as testnet; run with --network xrplEvmMainnet:
#   1. deployPermissionlessSimple7702.ts   (Simple7702Account 0xe6Cae83B… — delegation target)
#   2. deployImplementation.ts → deployFactory.ts → deployPlatformPaymaster.ts
#      (PLATFORM_ADDRESS = mainnet platform wallet; set DAILY_LIMIT_ETH)
#   3. stakePlatformPaymaster.ts           (owner key; STAKE_AMOUNT_ETH / DEPOSIT_AMOUNT_ETH)
#   4. setUserWhitelist.ts → deployRegistryGasless.ts → checkRegistryRoles.ts
# Use the NEW mainnet key as PRIVATE_KEY (never the testnet key 0xC04A…).
# Bundler: our own Alto (Pimlico does not support XRPL EVM).
BUNDLER_URL_XRPL_EVM_MAINNET=https://alto-xrpl-evm-mainnet.blockpeer.finance
PAYMASTER_IMPLEMENTATION_XRPL_EVM_MAINNET=0xdd44c204719d454db97fc53e78c53c7fef888c7c
FACTORY_ADDRESS_XRPL_EVM_MAINNET=0xa4708d8db160f7698951f0a250b9073d5910600e
PAYMASTER_ADDRESS_XRPL_EVM_MAINNET=0x485BEe7676ef61aBd70244b1ccE9206318bc2E9F
# TrustVC infrastructure on XRPL EVM Mainnet (pre-deployed — do not change)
TDOC_DEPLOYER_ADDRESS_XRPL_EVM_MAINNET=0xD9cF9513131d36290097DCbb836dD69841e660C6
TDOC_IMPLEMENTATION_XRPL_EVM_MAINNET=0x46df2A9e23760323BF833A565E7134E6061dA52F
REGISTRY_ADDRESS_XRPL_EVM_MAINNET=0x_filled_after_deployRegistry

STAKE_AMOUNT_ETH=1
NETWORK=xrplEvmTestnet
PAYMASTER_ADDRESS=0x7B0057a6671776626f5410F31523a67b36639E35

WHITELIST_ADDRESS=0xC04Af4f9817605340d39104E91fc1709F315E549 
WHITELIST_CREDITS=3 