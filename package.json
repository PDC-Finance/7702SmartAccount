{
  "name": "@trustvc/eip7702",
  "version": "0.1.0",
  "description": "EIP-7702 smart account, platform paymaster, and factory contracts for TrustVC",
  "author": "DexTech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrustVC/7702SmartAccount.git"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "dev",
        "prerelease": "beta",
        "channel": "beta"
      }
    ],
    "tagFormat": "v${version}"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "contracts/EIP7702Implementation.sol",
    "contracts/Factory.sol",
    "contracts/PlatformPaymaster.sol"
  ],
  "scripts": {
    "build:sol": "TS_NODE_TRANSPILE_ONLY=1 hardhat compile",
    "build:abis": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/generate-abis.ts",
    "build:js": "tsup",
    "build": "npm run build:sol && npm run build:abis && npm run build:js",
    "clean": "rm -rf dist cache artifacts src/abis",
    "lint": "eslint src scripts test --ext .ts",
    "lint:fix": "npm run lint -- --fix",
    "prepublishOnly": "npm run build",
    "semantic-release": "semantic-release",
    "test": "TS_NODE_TRANSPILE_ONLY=1 hardhat test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@account-abstraction/contracts": "^0.8.0",
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-viem": "^0.15.16",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox-viem": "^4.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/hardhat-viem": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^7.1.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "chai": "^4.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "hardhat": "^2.28.6",
    "hardhat-gas-reporter": "^2.3.0",
    "permissionless": "^0.3.5",
    "semantic-release": "^24.0.0",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "viem": "^2.56.8"
  }
}
